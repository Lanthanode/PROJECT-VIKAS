# ============================================================================
# RAILWAY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Port
PORT=3000

# Node Environment
NODE_ENV=development

# Optional Remote PostgreSQL Database URL
# If left commented or blank, the system automatically uses the embedded
# PostgreSQL 16 PGlite engine with full triggers, views, and ACID compliance.
#
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# Admin Master Password for Portal Access
ADMIN_PASSWORD=admin123
